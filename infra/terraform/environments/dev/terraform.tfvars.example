# コピーして terraform.tfvars として編集: cp terraform.tfvars.example terraform.tfvars

aws_region  = "ap-northeast-1"
project_name = "waniar"

# ⚠ ECR は IMMUTABLE タグ設定です。:latest は使えません。
# git SHA やセマンティックバージョンを使用してください。
# ダイジェスト例: "...@sha256:abc123..."
game_backend_image = "123456789012.dkr.ecr.ap-northeast-1.amazonaws.com/waniar-game-backend:v0.1.0"
agent_image        = "123456789012.dkr.ecr.ap-northeast-1.amazonaws.com/waniar-agent:v0.1.0"

# Agent: Bedrock（既定は Claude 3 Haiku）。AWS コンソールでモデルアクセスを有効化すること
# agent_bedrock_model_id = "anthropic.claude-3-haiku-20240307-v1:0"

# 任意: OpenAI にフォールバックさせる場合のみ。設定時は Secrets Manager に保存され ECS が参照
# agent_openai_api_key = "sk-..."

# フロント静的配信（S3 + CloudFront）。不要なら false
# enable_static_frontend = true
# 独自ドメイン + HTTPS（ACM は us-east-1 で発行し、ここに ARN とドメインを渡す）
# frontend_acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# frontend_domain_aliases        = ["app.example.com"]

# game-backend の AGENT_URL（terraform output -raw agent_alb_dns の http://...）
# game_agent_url = "http://waniar-agent-xxxxx.ap-northeast-1.elb.amazonaws.com"

# フロントを S3/CloudFront へ出す前のビルド例（game_backend_alb_dns に合わせる）:
#   VITE_GAME_API_BASE="http://<game_backend_alb>/api/v1" \
#   VITE_GAME_WS_BASE="ws://<game_backend_alb>/ws" \
#   npm run build
# HTTPS の CloudFront から HTTP の ALB へ fetch/ws するとブラウザの混合コンテンツでブロックされることがあるため、本番は ALB の HTTPS 化や CloudFront 経由のオリジン統合などを検討すること。

tags = {
  Environment = "dev"
}
