project_name         = "waniar"
environment          = "prod"
aws_region           = "ap-northeast-1"
kubernetes_version   = "1.30"

domain_name          = "example.com"
route53_zone_id      = "Z0000000000000"
enable_cloudfront    = true

# Keep a single node for single-replica backend
node_desired_capacity = 1
node_min_size         = 1
node_max_size         = 1

# Optional: override image directly.
# If empty, Terraform uses "<ecr_repo>:latest".
backend_image_uri = ""
backend_image_tag = "latest"

# Make destroy one-command friendly.
s3_force_destroy = true
ecr_force_delete = true

# EKS API access control (recommended for environment portability)
enable_current_caller_cluster_admin = true
eks_cluster_admin_principal_arns = [
  # "arn:aws:iam::123456789012:role/your-ci-role",
  # "arn:aws:iam::123456789012:user/your-admin-user",
]
