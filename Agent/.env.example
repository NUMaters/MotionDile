AGENT_PORT=8091
# ECS では Terraform が AWS_REGION / BEDROCK_MODEL_ID を渡す想定
AWS_REGION=ap-northeast-1
# 低コスト向け既定は Claude 3 Haiku（未設定かつ AWS_REGION ありならコード既定を使用）
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# Bedrock のみでよい場合は空でよい。OpenAI にフォールバックする場合のみ設定
OPENAI_API_KEY=
# ローカルで Bedrock を使わずに OpenAI だけ試す場合は BEDROCK_DISABLED=1
# BEDROCK_DISABLED=1
