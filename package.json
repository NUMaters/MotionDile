{
  "name": "waniar",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build:model": "node modeling/scripts/build-wani-game-model.mjs",
    "viewer": "npx serve modeling -l 3000 --no-clipboard",
    "dev": "concurrently -k -n backend,frontend \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "cd medea-pipeline/backend && go run ./cmd/server",
    "dev:game-backend": "cd game/backend && go run ./cmd/server",
    "dev:all": "concurrently -k -n game,medea,frontend \"npm:dev:game-backend\" \"npm:dev:backend\" \"npm:dev:frontend\"",
    "down:all": "for p in 5173 8080 8090; do lsof -ti -iTCP:$p -sTCP:LISTEN 2>/dev/null | xargs kill 2>/dev/null; done; echo 'all stopped'",
    "build": "vite build",
    "preview": "vite preview",
    "pipeline:train": "npx --yes tsx medea-pipeline/scripts/train-hand-control-model.ts",
    "pipeline:train:example": "npx --yes tsx medea-pipeline/scripts/train-hand-control-model.ts medea-pipeline/data/hand-dataset.example.json public/models/hand-control-model.json"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.34",
    "lucide": "^1.8.0",
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@types/node": "^22.14.0",
    "@types/three": "^0.175.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^9.2.1",
    "serve": "^14.2.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.2.5"
  }
}
