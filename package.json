{
  "name": "waniar",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build:model": "node modeling/scripts/build-wani-game-model.mjs",
    "viewer": "npx serve modeling -l 3000 --no-clipboard",
    "dev": "concurrently -k -n backend,frontend \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "cd medea-pipeline/backend && go run ./cmd/server",
    "build": "vite build",
    "preview": "vite preview",
    "pipeline:train": "node medea-pipeline/scripts/train-hand-control-model.mjs",
    "pipeline:train:example": "node medea-pipeline/scripts/train-hand-control-model.mjs medea-pipeline/data/hand-dataset.example.json public/models/hand-control-model.json"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.34",
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^9.2.1",
    "serve": "^14.2.4",
    "vite": "^6.2.5"
  }
}
