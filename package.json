{
  "name": "waniar",
  "private": true,
  "version": "0.0.1",
  "type": "module",
"scripts": {
    "build:model": "node modeling/scripts/build-wani-game-model.mjs",
    "viewer": "npx serve modeling -l 3000 --no-clipboard",
    "dev": "vite",
    "dev:game-backend": "go run -C game/backend ./cmd/server",
    "dev:agent": "go run -C Agent ./cmd/server",
    "dev:all": "concurrently -k -n game,agent,frontend \"npm:dev:game-backend\" \"npm:dev:agent\" \"npm:dev\"",
    "down:all": "node scripts/down-all.mjs",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.34",
    "lucide": "^1.8.0",
    "three": "^0.175.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@types/node": "^22.14.0",
    "@types/three": "^0.175.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.2.1",
    "kill-port": "^2.0.1",
    "serve": "^14.2.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.2.5"
  }
}
